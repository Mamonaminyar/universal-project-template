{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mamonaminyar/universal-project-template/schemas/configuration-analysis.schema.json",
  "title": "Universal Configuration Analysis",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "projectRoot",
    "status",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "projectRoot": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED"
      ]
    },
    "summary": {
      "type": "object"
    },
    "findings": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
